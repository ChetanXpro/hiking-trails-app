# Copy to .env.production. Keep this file out of source control.
COMPOSE_PROJECT_NAME=hiking
DOMAIN=maps.example.com
APP_ORIGIN=https://maps.example.com
HTTP_PORT=80
HTTPS_PORT=443
# Numeric non-root owner of this checkout/data on the VPS (`id -u`, `id -g`).
DEPLOY_UID=1000
DEPLOY_GID=1000
# Oracle Ampere A1: linux/arm64. Typical Intel/AMD VPS: linux/amd64.
DEPLOY_PLATFORM=linux/amd64

# Set IMAGE_PREFIX to a registry/repository prefix when images are built in CI
# or on a workstation, e.g. ghcr.io/acme/hiking. APP_VERSION must be immutable.
IMAGE_PREFIX=hiking
APP_VERSION=REPLACE_WITH_GIT_SHA
# Database image lifecycle is independent from application releases. Change
# only as a deliberate PostgreSQL/PostGIS upgrade with a tested restore.
POSTGIS_IMAGE_VERSION=pg16.14-postgis3.6.4-r1
# Increment independently when database/terrain contents change. This value is
# embedded in tile cache keys and must identify an immutable data release.
DATA_RELEASE=REPLACE_WITH_DATA_RELEASE

# Use URL-safe random passwords (hex/base64url) because they are embedded in
# libpq URLs. Example: openssl rand -hex 32
POSTGRES_DB=hiking
POSTGRES_USER=hiking_admin
PGDATA_VOLUME_NAME=hiking_pgdata_v1
POSTGRES_PASSWORD=replace-with-64-hex-characters
API_DB_PASSWORD=replace-with-another-64-hex-value
IMPORT_DB_PASSWORD=replace-with-another-64-hex-value
MARTIN_DB_PASSWORD=replace-with-another-64-hex-value

RUST_LOG=info
MARTIN_LOG_LEVEL=info
MARTIN_CACHE_SIZE_MB=96
MARTIN_DB_POOL_SIZE=8
# Space-separated root-level tile archives that Martin may publish. Keep the
# old 21-GB terrain_rgb.mbtiles off the production server.
MARTIN_TILE_ARCHIVES=terrain_rgb_hma.mbtiles

# Host directory populated by scripts/sync_deployment_data.sh.
DATA_DIR=./data

# Runtime data: only the normalized DB dump and terrain MBTiles are needed.
RESTORE_DUMP=bootstrap/hiking-data.dump

# Optional import profile data. Do not keep the analysis DEM on a small runtime
# VPS after the import has finished.
IMPORT_PBF=imports/hp.osm.pbf
DEM_PATH=/data/imports/hma_fused.tif
DEM_PATHS=
# Optional; leave empty unless the matching artifact was included in the
# import release manifest.
WORLDCOVER_PATH=
OSM_ORIGINAL_MAPPERS_PATH=
# WORLDCOVER_PATH=/data/imports/worldcover_himachal.tif
# OSM_ORIGINAL_MAPPERS_PATH=/data/imports/original_mappers.json
ELEVATION_SAMPLE_SPACING_M=30
ELEVATION_SMOOTHING_WINDOW_SAMPLES=5
ELEVATION_GAIN_LOSS_THRESHOLD_M=10
ELEVATION_MAX_SAMPLES=20000
# Keep false in production so an old tile directory can never silently replace
# the explicitly selected fused analysis DEM.
DEM_AUTO_DISCOVER=false
# Enable only for a complete, authoritative raw snapshot. Partial extracts must
# leave this false or valid trails outside the extract would be removed.
IMPORT_PRUNE_MISSING_TRAILS=false

# Host your basemap style and glyphs in your own R2 bucket/custom domain.
# PUBLIC_* values are read at container startup, so one web image works in
# staging and production without rebuilding.
PUBLIC_BASEMAP_STYLE_URL=https://map-assets.example.com/styles/outdoor.json
PUBLIC_BASEMAP_LABEL_ANCHOR_ID=
PUBLIC_MAP_GLYPHS_URL=https://map-assets.example.com/fonts/{fontstack}/{range}.pbf
PUBLIC_RASTER_TILE_URL=
PUBLIC_RASTER_TILE_ATTRIBUTION=
# Leave these blank to use Compose's same-origin defaults, which automatically
# embed DATA_RELEASE. Set an explicit HTTPS URL only for a separate tile origin.
PUBLIC_MARTIN_TRAILS_URL=
PUBLIC_MARTIN_OUTDOOR_WAYPOINTS_URL=
PUBLIC_TERRAIN_RGB_URL=
PUBLIC_TERRAIN_RGB_ENCODING=mapbox
PUBLIC_TERRAIN_RGB_TILE_SIZE=512
PUBLIC_TERRAIN_RGB_MAX_ZOOM=13
PUBLIC_TERRAIN_RGB_BOUNDS=75,30,79,34
PUBLIC_TERRAIN_ATTRIBUTION=
# Leave empty to disable weather. PUBLIC_* is delivered to every browser: never
# place a secret provider key here. Use a domain-restricted public token or,
# preferably, a same-origin cached proxy that keeps its secret server-side.
PUBLIC_WEATHER_API_URL=

# Conservative defaults for a 2 GB prototype VPS. Raise Martin/DB first if
# real traffic or a larger region needs it.
DB_MEMORY_LIMIT=640m
MARTIN_MEMORY_LIMIT=384m
API_MEMORY_LIMIT=256m
WEB_MEMORY_LIMIT=128m
GATEWAY_MEMORY_LIMIT=96m
DB_SHARED_BUFFERS=128MB
DB_EFFECTIVE_CACHE_SIZE=512MB
DB_MAX_CONNECTIONS=40
MIGRATE_MEMORY_LIMIT=192m
RESTORE_MEMORY_LIMIT=256m
IMPORT_MEMORY_LIMIT=768m
CLEANUP_MEMORY_LIMIT=128m
OSM2PGSQL_CACHE_MB=256
API_DB_POOL_MIN_CONNECTIONS=1
API_DB_POOL_MAX_CONNECTIONS=10
DB_CONNECT_TIMEOUT_SECONDS=10
DB_ACQUIRE_TIMEOUT_SECONDS=5
DB_IDLE_TIMEOUT_SECONDS=600
DB_MAX_LIFETIME_SECONDS=1800
API_DB_STATEMENT_TIMEOUT_MS=15000
API_DB_LOCK_TIMEOUT_MS=3000
API_WORKERS=2
API_MAX_CONNECTIONS=32
API_MAX_IN_FLIGHT_REQUESTS=32
API_REQUEST_TIMEOUT_SECONDS=30
API_QUEUE_TIMEOUT_MS=2000
API_READINESS_TIMEOUT_MS=1000
# Production uses tighter export ceilings than the compiled absolute maximum.
# The current prototype dataset's longest route is comfortably below these values.
API_EXPORT_MAX_POINTS=25000
API_EXPORT_MAX_BODY_BYTES=2097152
API_KEEP_ALIVE_SECONDS=15
API_CLIENT_REQUEST_TIMEOUT_SECONDS=10
API_CLIENT_DISCONNECT_TIMEOUT_SECONDS=5
API_SHUTDOWN_TIMEOUT_SECONDS=30
# Keep this above API_SHUTDOWN_TIMEOUT_SECONDS so graceful draining can finish.
API_STOP_GRACE_PERIOD_SECONDS=45
