# Copy this file to .env and adjust if needed:
#   cp .env.example .env
# .env is gitignored -- it's your local config, not something to commit.

DATABASE_URL=postgres://postgres:postgres@localhost:5432/hiking
VITE_MARTIN_OUTDOOR_WAYPOINTS_URL=/outdoor_waypoints/{z}/{x}/{y}

# Used by the `db` container itself (docker-compose reads this same
# file to configure Postgres on first boot).
POSTGRES_DB=hiking
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

RUST_LOG=info

# Optional offline attribution cache. Each entry must come from version 1 of
# an OSM hiking route relation. The importer never contacts OSM itself.
# See data/original_mappers.example.json and README.md.
OSM_ORIGINAL_MAPPERS_PATH=

# Optional frontend basemap configuration.
# Leave the default vector style in place for crisp labels + terrain.
# Set VITE_BASEMAP_STYLE_URL=raster to force the legacy raster OSM fallback.
VITE_BASEMAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
# Recommended in production: point this at a glyph endpoint you control.
VITE_MAP_GLYPHS_URL=
# Optional explicit label anchor for a custom style JSON.
VITE_BASEMAP_LABEL_ANCHOR_ID=

# Optional frontend terrain configuration.
# These must match the actual DEM tileset you serve:
# - this repo's fused `terrain_rgb_hma.mbtiles` uses Mapbox encoding and 512px tiles
# - a Mapterhorn extract uses Terrarium encoding, 512px tiles, and usually z12
#   as the honest source ceiling for 30m DEM data
VITE_TERRAIN_RGB_URL=/terrain_rgb_hma/{z}/{x}/{y}
VITE_TERRAIN_RGB_ENCODING=mapbox
VITE_TERRAIN_RGB_TILE_SIZE=512
VITE_TERRAIN_RGB_MAX_ZOOM=13
# Geographic coverage of the fused HMA/Copernicus pyramid (west,south,east,north).
# Change or clear this when pointing VITE_TERRAIN_RGB_URL at another tileset.
VITE_TERRAIN_RGB_BOUNDS=75,30,79,34
# Optional HTML attribution override for a different terrain source.
VITE_TERRAIN_ATTRIBUTION=

# Optional: one DEM tile, or a comma-separated set of DEM tiles, used to
# generate elevation profiles, ascent/descent stats, and better time
# estimates during import.
# When multiple DEMs overlap, the importer now prefers the finer-resolution
# source automatically when it can infer coverage/resolution from gdalinfo.
# Examples:
# DEM_PATH=/absolute/path/to/N32E077_FABDEM_V1-2.tif
# DEM_PATHS=/abs/N32E077_FABDEM_V1-2.tif,/abs/N32E078_FABDEM_V1-2.tif
DEM_PATH=
DEM_PATHS=

# Optional: ESA WorldCover GeoTIFF for caching coarse terrain segments.
WORLDCOVER_PATH=

# Optional raster-processing tuning knobs.
ELEVATION_SAMPLE_SPACING_M=30
ELEVATION_SMOOTHING_WINDOW_SAMPLES=5
ELEVATION_GAIN_LOSS_THRESHOLD_M=10
