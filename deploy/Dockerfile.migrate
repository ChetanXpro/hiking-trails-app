# syntax=docker/dockerfile:1.7
FROM rust:1.96.0-bookworm AS build

WORKDIR /app
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates

RUN --mount=type=cache,id=hiking-cargo-registry,target=/usr/local/cargo/registry \
    --mount=type=cache,id=hiking-cargo-git,target=/usr/local/cargo/git \
    --mount=type=cache,id=hiking-migrate-target,target=/app/target \
    cargo build --locked --release -p hiking-db --bin hiking-migrate && \
    install -Dm755 target/release/hiking-migrate /out/hiking-migrate

FROM debian:bookworm-slim AS runtime

RUN apt-get update && \
    apt-get install --yes --no-install-recommends ca-certificates postgresql-client && \
    rm -rf /var/lib/apt/lists/* && \
    groupadd --gid 10001 app && \
    useradd --uid 10001 --gid app --no-create-home --shell /usr/sbin/nologin app

COPY --from=build /out/hiking-migrate /usr/local/bin/hiking-migrate
COPY migrations /app/migrations
COPY deploy/sql/apply_runtime_grants.sql /app/deploy/sql/apply_runtime_grants.sql
COPY --chmod=755 deploy/migrate-entrypoint.sh /usr/local/bin/migrate-entrypoint
WORKDIR /app
USER app
ENTRYPOINT ["/usr/local/bin/migrate-entrypoint"]
