# syntax=docker/dockerfile:1.7
FROM node:22.23.1-alpine3.24 AS build

RUN corepack enable && corepack prepare pnpm@10.25.0 --activate
WORKDIR /app

COPY web/package.json web/pnpm-lock.yaml web/pnpm-workspace.yaml ./
RUN --mount=type=cache,id=hiking-pnpm,target=/pnpm/store \
    pnpm config set store-dir /pnpm/store && \
    pnpm install --frozen-lockfile

COPY web ./

RUN pnpm build && pnpm prune --prod

FROM node:22.23.1-alpine3.24 AS runtime

ENV NODE_ENV=production \
    HOST=0.0.0.0 \
    PORT=3000
WORKDIR /app

RUN addgroup -g 10001 app && adduser -D -H -u 10001 -G app app
COPY --from=build --chown=app:app /app/package.json ./package.json
COPY --from=build --chown=app:app /app/build ./build
# Adapter-node bundles most server code, but browser-only packages such as
# MapLibre remain external SSR imports. Keep their pruned production closure;
# a build-only image that copies `build/` alone starts locally (where a parent
# node_modules exists) and then fails in the clean container.
COPY --from=build --chown=app:app /app/node_modules ./node_modules

USER app
EXPOSE 3000
ENTRYPOINT ["node", "build"]
