# syntax=docker/dockerfile:1.7
# The upstream postgis/postgis image currently publishes amd64 only. The
# official PostgreSQL image and PGDG's PostGIS packages both publish amd64 and
# arm64, so this small wrapper keeps the database identical on either VPS type.
FROM postgres:16.14-bookworm@sha256:da788743d2060767375896de4d646f7576f5911461444b372616f19ea61db2ec

ARG POSTGIS_PACKAGE_VERSION=3.6.4+dfsg-2.pgdg12+1

RUN apt-get update && \
    apt-get install --yes --no-install-recommends \
      ca-certificates \
      postgresql-${PG_MAJOR}-postgis-3=${POSTGIS_PACKAGE_VERSION} \
      postgresql-${PG_MAJOR}-postgis-3-scripts=${POSTGIS_PACKAGE_VERSION} && \
    rm -rf /var/lib/apt/lists/*
